{
  "name": "landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "cd server && tsx watch server.ts",
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\" ",
    "build": "npm run build:server && npm run build:service",
    "build:service": "tsc -b && vite build",
    "build:server": "cd server && tsc -p tsconfig.json && tsc-alias",
    "lint": "eslint .",
    "start": "pm2 startOrRestart ecosystem.config.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^7.9.1",
    "axios": "^1.13.6",
    "concurrently": "^10.0.5",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.26.1",
    "motion": "^12.23.25",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "react": "^19.1.0",
    "react-daum-postcode": "^3.2.0",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.72.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.1",
    "react-spinners": "^0.17.0",
